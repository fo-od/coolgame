{
  "$schema": "https://raw.githubusercontent.com/fo-od/obt/refs/heads/main/schema/obt.schema.json",
  "name": "coolgame",
  "build": {
    "out": ".build",
    "useOlsCollections": true,
    "variables": {
      "GIT_HASH": {
        "value": "invalid hash",
        "command": "git rev-parse --short HEAD"
      }
    }
  },
  "actions": {
    "run-debug": {
      "command": "odin run ${src} -out:${out}/${name}-temp ${flags} -define:GAME_DEBUG=true",
      "description": "Run the project with GAME_DEBUG=true"
    }
  }
}
